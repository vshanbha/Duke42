# --- Software Factory (softwareaifactory.sh) additions ---
# Gate-block event log for `factory report`
.factory/
# Eval current-run artifacts (baselines are tracked, runs are not)
eval/results/*-current.json
eval/results/current-run.json
eval/results/last-run.json
eval/results/mock-*.json
# Loop-close transient flags
memory/.pending-lesson-reminder
memory/PENDING-LESSONS.md
memory/.parity-stale

# Spring Shell REPL command history (runtime artifact)
spring-shell.log
